# Postgres (docker-compose exposes on 5433 to avoid clashing with any local server)
DATABASE_URL=postgresql+psycopg://gmaps:gmaps_dev@localhost:5433/gmaps_leads

# Politeness knobs (scraper) — config, never hardcode
SCRAPE_DELAY_MIN_S=3
SCRAPE_DELAY_MAX_S=8
SCRAPE_DAILY_CAP=400
SCRAPE_COOLDOWN_HOURS=6
SCRAPE_HEADLESS=false

# LLM (phase 6) — vendor-neutral client. Two supported wire formats:
#   LLM_API_FORMAT=anthropic  -> Z.ai coding-plan key (api.z.ai/api/anthropic)
#   LLM_API_FORMAT=openai     -> OpenAI-compatible servers, incl. self-hosted vLLM (Qwen)
#
# --- Z.ai coding plan (GLM-4.6) ---
LLM_API_FORMAT=anthropic
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=
LLM_MODEL=GLM-4.6
#
# --- Self-hosted vLLM (Qwen 3.5 4B) ---
# LLM_API_FORMAT=openai
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=token-or-dummy
# LLM_MODEL=Qwen/Qwen3.5-4B
