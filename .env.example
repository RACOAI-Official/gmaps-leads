# Postgres (docker-compose exposes on 5433 to avoid clashing with any local server)
DATABASE_URL=postgresql+psycopg://gmaps:gmaps_dev@localhost:5433/gmaps_leads

# Politeness knobs (scraper) — config, never hardcode
SCRAPE_DELAY_MIN_S=3
SCRAPE_DELAY_MAX_S=8
SCRAPE_DAILY_CAP=400
SCRAPE_COOLDOWN_HOURS=6
SCRAPE_HEADLESS=false

# LLM (phase 6) — OpenAI-compatible; point at GLM/Z.ai endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
